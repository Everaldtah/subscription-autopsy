# Server
PORT=3001
NODE_ENV=production

# Optional: Plaid API for direct bank connection (vs CSV upload)
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret
PLAID_ENV=sandbox  # sandbox | development | production

# Optional: Email reports
SENDGRID_API_KEY=SG.xxx
REPORT_FROM_EMAIL=reports@subscriptionautopsy.com
REPORT_RECIPIENTS=cfo@company.com,ops@company.com

# Optional: Slack weekly digest
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional: Auth
JWT_SECRET=your-jwt-secret-here

# Optional: Database for storing analysis history
DATABASE_URL=postgresql://user:pass@localhost:5432/sub_autopsy
